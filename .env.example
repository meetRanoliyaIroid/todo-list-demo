# Database Configuration
# Set DB_CONNECTION to 'postgres' for PostgreSQL or 'mysql' for MySQL
DB_CONNECTION=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_NAME=todo_list_db

# For MySQL, use these settings instead:
# DB_CONNECTION=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USERNAME=root
# DB_PASSWORD=your_password
# DB_NAME=todo_list_db

# Server Configuration
PORT=3000
HOST=localhost

# Security Configuration
# Set IS_SECURE=true to enable HTTPS
IS_SECURE=false
# Set IS_PROXY=true if behind a proxy (like nginx)
IS_PROXY=false
# SSL Certificate path (required if IS_SECURE=true)
# SSL_CERT_BASE_PATH=/path/to/ssl/certificates

# When you run tests, use NODE_ENV='test'. Otherwise, use local, development, or production as per the environment.#
NODE_ENV=local
