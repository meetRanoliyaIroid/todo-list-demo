# Database Configuration
# Set DB_CONNECTION to 'postgres' for PostgreSQL or 'mysql' for MySQL
DB_CONNECTION=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_NAME=todo_list_db

# For MySQL, use these settings instead:
# DB_CONNECTION=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USERNAME=root
# DB_PASSWORD=your_password
# DB_NAME=todo_list_db

# Server Configuration
PORT=3000
HOST=localhost
